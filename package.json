{
  "name": "silicon-seeds",
  "version": "1.0.0",
  "description": "Whoever has ears, let them hear.",
  "homepage": "https://github.com/DennisLoska/silicon-seeds#readme",
  "bugs": {
    "url": "https://github.com/DennisLoska/silicon-seeds/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DennisLoska/silicon-seeds.git"
  },
  "license": "UNLICENSED",
  "author": "Dennis Loska",
  "type": "commonjs",
  "main": "src/main.ts",
  "scripts": {
    "prestart": "tsc --noEmit",
    "start": "bun src/main.ts",
    "start:based": "bun src/main.ts",
    "start:hot": "bun --hot src/main.ts",
    "build:css": "npx @tailwindcss/cli -i src/templates/app.css -o static/style.css",
    "watch:css": "npx @tailwindcss/cli -i src/templates/app.css -o static/style.css --watch",
    "build:hyperframes-island": "bun build src/hypercut/hyperframes-island.tsx --outdir static/js --target browser",
    "watch:hyperframes-island": "bun build src/hypercut/hyperframes-island.tsx --outdir static/js --target browser --watch",
    "db:migrate": "bun src/db/migrate.ts",
    "db:rollback": "bun src/db/rollback.ts",
    "db:chroma": "bunx chroma run --path ./chroma-data --port 8000",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@chroma-core/default-embed": "^0.1.9",
    "@hono/zod-validator": "^0.7.6",
    "@lmstudio/sdk": "^1.5.0",
    "@logtape/logtape": "^2.0.4",
    "@logtape/pretty": "^2.0.4",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.2.2",
    "chromadb": "^3.4.3",
    "daisyui": "^5.5.19",
    "hono": "^4.12.9",
    "jiti": "^2.6.1",
    "kysely": "^0.28.14",
    "kysely-bun-sqlite": "^0.4.0",
    "mcp-searxng": "^1.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typed-htmx": "^0.3.1",
    "zod": "^4.3.6"
  }
}
