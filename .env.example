# ComfyUI URL
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_BASE_WS=ws://127.0.0.1:8188

# Comfy UI default directories
OUTPUT_DIR=/run/media/dennis/ai/comfy-ui/output
INPUT_DIR=/run/media/dennis/ai/comfy-ui/input

# Content library
CONTENT_LIBRARY_DIR=/home/dennis/work/silicon-seeds/content

# Whisperx
WHISPER_X=/home/dennis/work/transcripts/.venv/bin/whisperx
YT_DLP=/home/dennis/work/transcripts/.venv/bin/yt-dlp

# Logger
LOG_LEVEL=info

# Runtime
NODE_ENV=development

# LLM model
LLM_MODEL="qwen3.6-35b-a3b"

# ChromaDB vector store
CHROMADB_PORT=8000

# Embedding model for ChromaDB vector search
EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b

# Voicebox TTS server
VOICEBOX_URL=http://127.0.0.1:17493
